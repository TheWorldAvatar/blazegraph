<?xml version="1.0"?>
<Configuration name="Log4j1">
    <Appenders>
        <Console name="Stdout" target="SYSTEM_OUT">
            <PatternLayout pattern="%m%n" />
        </Console>
    </Appenders>
    <Loggers>
        <Root level="DEBUG">
            <AppenderRef ref="Stdout" />
        </Root>
    </Loggers>
</Configuration>